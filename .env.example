# Server only. Never prefix this secret with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Optional. Image calls remain disabled unless explicitly enabled on the server.
# Gemini image models currently require a project with image generation access.
IMAGE_GENERATION_ENABLED=false
# Select gemini for the hosted image API or comfyui for a local loopback server.
IMAGE_PROVIDER=gemini
# Local ComfyUI API; it must bind to 127.0.0.1 and is for local testing only.
COMFYUI_API_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=sd_xl_turbo_1.0_fp16.safetensors
# Only true for a loopback origin behind the dedicated Cloudflare connector.
TRUST_CLOUDFLARE_PROXY=false
