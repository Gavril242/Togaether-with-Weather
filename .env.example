# Server only. Never prefix this secret with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Optional. Image calls remain disabled unless explicitly enabled on the server.
# Gemini image models currently require a project with image generation access.
IMAGE_GENERATION_ENABLED=false
# Only true for a loopback origin behind the dedicated Cloudflare connector.
TRUST_CLOUDFLARE_PROXY=false
